<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 선택 화면(Android 12+)에서 보이는 예시. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="#FFFFFF">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="4dp" android:paddingBottom="2dp" android:textSize="16sp" android:textStyle="bold" android:textColor="#1E293B" android:text="오늘 할 일 1/3" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp">
    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#1E293B" android:text="☐" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:textColor="#1E293B" android:text="준비물 챙기기" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp">
    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#1E293B" android:text="☐" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:textColor="#1E293B" android:text="영어 숙제" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp">
    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#94A3B8" android:text="☑" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:textColor="#94A3B8" android:text="책 읽기" />
  </LinearLayout>
</LinearLayout>
