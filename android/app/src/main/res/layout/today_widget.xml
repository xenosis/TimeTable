<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘 일정 위젯. RemoteViews는 View를 쓸 수 없어 표식도 TextView로 만든다. 줄 수는 위젯 높이에 맞춰 코드에서 보이거나 숨긴다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="8dp" android:background="#FFFFFF">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="4dp" android:paddingBottom="2dp" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:text="오늘 일정" />
  <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="4dp" android:paddingTop="6dp" android:textSize="16sp" android:visibility="gone" />
  <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp" android:paddingRight="4dp" android:visibility="gone">
    <TextView android:id="@+id/widget_marker_1" android:layout_width="6dp" android:layout_height="18dp" android:layout_marginRight="6dp" />
    <TextView android:id="@+id/widget_time_1" android:layout_width="wrap_content" android:minWidth="46dp" android:layout_marginRight="6dp" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp" android:paddingRight="4dp" android:visibility="gone">
    <TextView android:id="@+id/widget_marker_2" android:layout_width="6dp" android:layout_height="18dp" android:layout_marginRight="6dp" />
    <TextView android:id="@+id/widget_time_2" android:layout_width="wrap_content" android:minWidth="46dp" android:layout_marginRight="6dp" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp" android:paddingRight="4dp" android:visibility="gone">
    <TextView android:id="@+id/widget_marker_3" android:layout_width="6dp" android:layout_height="18dp" android:layout_marginRight="6dp" />
    <TextView android:id="@+id/widget_time_3" android:layout_width="wrap_content" android:minWidth="46dp" android:layout_marginRight="6dp" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp" android:paddingRight="4dp" android:visibility="gone">
    <TextView android:id="@+id/widget_marker_4" android:layout_width="6dp" android:layout_height="18dp" android:layout_marginRight="6dp" />
    <TextView android:id="@+id/widget_time_4" android:layout_width="wrap_content" android:minWidth="46dp" android:layout_marginRight="6dp" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp" android:paddingRight="4dp" android:visibility="gone">
    <TextView android:id="@+id/widget_marker_5" android:layout_width="6dp" android:layout_height="18dp" android:layout_marginRight="6dp" />
    <TextView android:id="@+id/widget_time_5" android:layout_width="wrap_content" android:minWidth="46dp" android:layout_marginRight="6dp" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_row_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp" android:paddingRight="4dp" android:visibility="gone">
    <TextView android:id="@+id/widget_marker_6" android:layout_width="6dp" android:layout_height="18dp" android:layout_marginRight="6dp" />
    <TextView android:id="@+id/widget_time_6" android:layout_width="wrap_content" android:minWidth="46dp" android:layout_marginRight="6dp" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_row_7" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingLeft="4dp" android:paddingRight="4dp" android:visibility="gone">
    <TextView android:id="@+id/widget_marker_7" android:layout_width="6dp" android:layout_height="18dp" android:layout_marginRight="6dp" />
    <TextView android:id="@+id/widget_time_7" android:layout_width="wrap_content" android:minWidth="46dp" android:layout_marginRight="6dp" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_title_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="4dp" android:paddingTop="2dp" android:textSize="14sp" android:maxLines="1" android:visibility="gone" />
</LinearLayout>
