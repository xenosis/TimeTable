{
  "name": "kidtimetable",
  "version": "1.36.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.23",
    "expo-background-task": "~57.0.20",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:ci": "jest --runInBand --no-cache",
    "lint": "expo lint app src __tests__ scripts dashboard .claude/hooks .codex/hooks --no-cache --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "code-length": "node scripts/check-file-length.cjs",
    "instructions:check": "node scripts/check-agent-instructions.cjs",
    "build": "node scripts/run-android-build.cjs",
    "check": "node scripts/run-quality-checks.cjs",
    "backlog": "node scripts/backlog/cli.cjs",
    "backlog-review": "node scripts/backlog/review-dispatch.cjs",
    "dashboard": "node dashboard/serve-dashboard.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.cjs"
    ]
  }
}
